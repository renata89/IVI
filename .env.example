# IVI — konfiguracja API (opcjonalne)
# Skopiuj do .env i wpisz swój klucz

# Wybierz backend LLM: openai, gemini, albo zostaw pusty (mock)
IVI_LLM_BACKEND=gemini
IVI_LLM_API_KEY=

# Google Calendar OAuth (opcjonalne — domyślnie mock)
# Uzyskaj dane na https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Port backendu (opcjonalnie, domyślnie 8765)
IVI_BACKEND_PORT=8765
