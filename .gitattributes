# Auto-detect text files
* text=auto

# Source code
*.js text
*.py text
*.html text diff=html
*.css text
*.json text
*.yml text
*.yaml text
*.md text
*.sh text

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.icns binary
*.ico binary
*.dmg binary
*.zip binary

# Git
.gitattributes text
.gitignore text
